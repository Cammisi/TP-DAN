# Copiá este archivo a .env (git lo ignora) antes de `docker compose up`.
# Son valores de ejemplo para desarrollo local: podés cambiarlos por los tuyos.

# Firma de los JWT. La comparten fan-identity-service (que los emite) y cloud-gateway (que los valida).
# Mínimo 32 caracteres: lo exige HS256.
JWT_SECRET=cambiar-por-un-secreto-propio-de-al-menos-32-caracteres

# Clave que alert-dispatcher-service manda en X-Internal-Api-Key para llamar a /internal/** de fan-identity-service.
INTERNAL_API_KEY=cambiar-por-una-clave-interna-propia
